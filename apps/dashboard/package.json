{
  "name": "@cleany/dashboard",
  "private": true,
  "version": "1.12.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "contracts:types": "openapi-typescript ../../packages/contracts/openapi.json --default-non-nullable false -o src/api/generated/openapi.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:robot-model": "playwright test -c playwright.robot-model.config.ts",
    "test:visual": "playwright test -c playwright.visual.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.7.1",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "1.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-is": "19.2.8",
    "react-router": "8.3.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.6.0",
    "three": "0.180.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
