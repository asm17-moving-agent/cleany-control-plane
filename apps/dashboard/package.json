{
  "name": "@cleany/dashboard",
  "private": true,
  "version": "1.11.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "contracts:types": "openapi-typescript ../../packages/contracts/openapi.json --default-non-nullable false -o src/api/generated/openapi.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:robot-model": "playwright test -c playwright.robot-model.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "latest",
    "@tanstack/react-query": "latest",
    "clsx": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "latest",
    "react-router": "latest",
    "tailwind-merge": "latest",
    "three": "0.180.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/vite": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "^22.20.4",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "latest",
    "jsdom": "latest",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "latest",
    "typescript": "^5.9.3",
    "vite": "latest",
    "vitest": "latest"
  }
}
