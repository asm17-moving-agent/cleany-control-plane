{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cleany.dev/contracts/seat.schema.json",
  "title": "Seat",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "seat_id",
    "label",
    "row",
    "grid_column",
    "occupancy",
    "occupant_name"
  ],
  "properties": {
    "mission_supported": { "type": ["boolean", "null"], "default": null, "description": "Runtime seat capability; null before the first capability snapshot." },
    "seat_id": { "type": "string", "pattern": "^seat-(?:[0-9]{2}|(?:a[1-4]|m[1-3])-0[1-6])$" },
    "label": { "type": "string", "pattern": "^(?:[0-9]{2}|(?:A[1-4]|M[1-3])-0[1-6])$" },
    "zone_id": { "enum": ["d-hub", "space-a1", "space-a2", "space-a3", "space-a4", "space-m1", "space-m2", "space-m3"], "default": "d-hub", "description": "Row and grid column are local to this zone. Omitted legacy values mean d-hub." },
    "row": { "type": "integer", "minimum": 1, "maximum": 6 },
    "grid_column": { "enum": [1, 2, 3, 5, 6, 8, 9, 10] },
    "occupancy": { "enum": ["AVAILABLE", "OCCUPIED", "UNKNOWN"] },
    "occupant_name": { "type": ["string", "null"] }
  },
  "examples": [
    { "seat_id": "seat-a1-01", "label": "A1-01", "zone_id": "space-a1", "row": 1, "grid_column": 1, "occupancy": "UNKNOWN", "occupant_name": null },
    { "seat_id": "seat-m1-06", "label": "M1-06", "zone_id": "space-m1", "row": 2, "grid_column": 3, "occupancy": "UNKNOWN", "occupant_name": null }
  ],
  "allOf": [
    {
      "if": {
        "properties": { "occupancy": { "const": "OCCUPIED" } },
        "required": ["occupancy"]
      },
      "then": {
        "properties": { "occupant_name": { "type": "string", "minLength": 1 } }
      },
      "else": {
        "properties": { "occupant_name": { "type": "null" } }
      }
    }
  ]
}
