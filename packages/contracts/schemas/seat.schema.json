{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cleany.dev/contracts/seat.schema.json",
  "title": "Seat",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "seat_id",
    "label",
    "row",
    "grid_column",
    "occupancy",
    "occupant_name"
  ],
  "properties": {
    "seat_id": { "type": "string", "pattern": "^seat-[0-9]{2}$" },
    "label": { "type": "string", "pattern": "^[0-9]{2}$" },
    "row": { "type": "integer", "minimum": 1, "maximum": 6 },
    "grid_column": { "enum": [1, 2, 3, 5, 6, 8, 9, 10] },
    "occupancy": { "enum": ["AVAILABLE", "OCCUPIED"] },
    "occupant_name": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "occupancy": { "const": "OCCUPIED" } },
        "required": ["occupancy"]
      },
      "then": {
        "properties": { "occupant_name": { "type": "string", "minLength": 1 } }
      },
      "else": {
        "properties": { "occupant_name": { "type": "null" } }
      }
    }
  ]
}
