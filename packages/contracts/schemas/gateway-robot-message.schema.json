    "RobotStatus": {
      "additionalProperties": false,
      "properties": {
        "active_mission_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Active Mission Id"
        },
        "boot_id": {
          "minLength": 1,
          "title": "Boot Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "IDLE",
            "BUSY",
            "ERROR"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "boot_id",
        "state",
        "active_mission_id"
      ],
      "title": "RobotStatus",
      "type": "object"
    },
    "SnapshotEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "const": "robot.snapshot",
          "title": "Event Type",
          "type": "string"
        },
        "mission_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mission Id"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/SnapshotPayload"
        },
        "robot_id": {
          "const": "cleany-01",
          "title": "Robot Id",
          "type": "string"
        },
        "schema_version": {
