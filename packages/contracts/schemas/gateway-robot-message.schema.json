        "event_type",
        "payload"
      ],
      "title": "RejectedEvent",
      "type": "object"
    },
    "RejectedPayload": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "message"
      ],
      "title": "RejectedPayload",
      "type": "object"
    },
    "ReportPayload": {
      "additionalProperties": false,
      "properties": {
        "after_observation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Observation"
        },
        "before_observation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Observation"
        },
        "completed_tasks": {
          "items": {
            "type": "string"
          },
          "title": "Completed Tasks",
          "type": "array"
        },
        "execution_profile": {
          "$ref": "#/$defs/ExecutionProfile"
        },
        "failed_task": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failed Task"
        },
        "failure_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Code"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "needs_human_review": {
          "default": false,
          "title": "Needs Human Review",
          "type": "boolean"
        },
        "outcome": {
          "$ref": "#/$defs/MissionOutcome"
        },
        "skipped_tasks": {
          "items": {
            "type": "string"
          },
          "title": "Skipped Tasks",
          "type": "array"
        }
      },
      "required": [
        "outcome",
        "execution_profile"
      ],
      "title": "ReportPayload",
      "type": "object"
    },
