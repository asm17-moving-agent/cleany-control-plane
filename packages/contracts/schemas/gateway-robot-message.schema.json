        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "robot_id",
        "mission_id",
        "sequence",
        "occurred_at",
        "event_type",
        "payload"
      ],
      "title": "PhaseEvent",
      "type": "object"
    },
    "PhasePayload": {
      "additionalProperties": false,
      "properties": {
        "before_observation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Observation"
        },
        "internal_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Internal State"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "phase": {
          "enum": [
            "NAVIGATING",
            "WORKING",
            "RETURNING"
          ],
          "title": "Phase",
          "type": "string"
        }
      },
      "required": [
        "phase"
      ],
      "title": "PhasePayload",
      "type": "object"
    },
    "RejectedEvent": {
