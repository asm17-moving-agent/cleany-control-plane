          "$ref": "#/$defs/AckPayload"
        },
        "robot_id": {
          "const": "cleany-01",
          "title": "Robot Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "robot_id",
        "mission_id",
        "sequence",
        "occurred_at",
        "event_type",
        "payload"
      ],
      "title": "AckEvent",
      "type": "object"
    },
    "AckPayload": {
      "additionalProperties": false,
      "properties": {
        "ack_event_id": {
          "format": "uuid",
          "title": "Ack Event Id",
          "type": "string"
        },
        "disposition": {
          "default": "applied",
          "enum": [
            "applied",
            "duplicate",
            "stale",
            "conflict"
          ],
          "title": "Disposition",
          "type": "string"
        }
      },
      "required": [
        "ack_event_id"
      ],
      "title": "AckPayload",
      "type": "object"
    },
    "CompletedReport": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "mission_id": {
          "format": "uuid",
          "title": "Mission Id",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ReportPayload"
        },
        "sequence": {
          "exclusiveMinimum": 0,
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "event_id",
        "mission_id",
        "sequence",
        "occurred_at",
        "payload"
      ],
      "title": "CompletedReport",
      "type": "object"
    },
    "ExecutionProfile": {
      "additionalProperties": false,
      "properties": {
        "execution": {
          "enum": [
            "sim",
            "real",
            "mock"
          ],
          "title": "Execution",
          "type": "string"
        },
        "navigation": {
          "enum": [
            "sim",
            "real",
            "mock"
          ],
          "title": "Navigation",
          "type": "string"
        },
        "perception": {
          "enum": [
            "sim",
            "real",
            "mock"
          ],
          "title": "Perception",
          "type": "string"
        },
        "planning": {
          "enum": [
            "sim",
            "real",
            "mock"
          ],
          "title": "Planning",
          "type": "string"
        }
      },
      "required": [
        "navigation",
        "perception",
        "planning",
        "execution"
      ],
      "title": "ExecutionProfile",
      "type": "object"
    },
    "HeartbeatEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "const": "robot.heartbeat",
          "title": "Event Type",
          "type": "string"
        },
        "mission_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mission Id"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/RobotStatus"
        },
        "robot_id": {
          "const": "cleany-01",
          "title": "Robot Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "robot_id",
        "mission_id",
        "sequence",
        "occurred_at",
        "event_type",
        "payload"
      ],
      "title": "HeartbeatEvent",
      "type": "object"
    },
    "MissionOutcome": {
      "enum": [
        "SUCCESS",
        "PARTIAL_SUCCESS",
        "HUMAN_REVIEW_REQUIRED",
        "BLOCKED",
        "FAILED",
        "CANCELLED",
        "EXPIRED",
        "REJECTED",
        "INTERRUPTED"
      ],
      "title": "MissionOutcome",
      "type": "string"
    },
    "PhaseEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "const": "mission.phase",
          "title": "Event Type",
          "type": "string"
        },
        "mission_id": {
          "anyOf": [
            {
              "format": "uuid",
