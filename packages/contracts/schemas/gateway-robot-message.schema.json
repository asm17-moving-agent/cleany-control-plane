        "event_type",
        "payload"
      ],
      "title": "SnapshotEvent",
      "type": "object"
    },
    "SnapshotPayload": {
      "additionalProperties": false,
      "properties": {
        "active_mission_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Active Mission Id"
        },
        "active_phase": {
          "anyOf": [
            {
              "enum": [
                "ACCEPTED",
                "NAVIGATING",
                "WORKING",
                "RETURNING"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Phase"
        },
        "active_sequence": {
          "default": 0,
          "minimum": 0,
          "title": "Active Sequence",
          "type": "integer"
        },
        "boot_id": {
          "minLength": 1,
          "title": "Boot Id",
          "type": "string"
        },
        "can_cancel": {
          "title": "Can Cancel",
          "type": "boolean"
        },
        "completed_reports": {
          "items": {
            "$ref": "#/$defs/CompletedReport"
          },
          "title": "Completed Reports",
          "type": "array"
        },
        "execution_profile": {
          "$ref": "#/$defs/ExecutionProfile"
        },
        "state": {
          "enum": [
            "IDLE",
            "BUSY",
            "ERROR"
          ],
          "title": "State",
          "type": "string"
        },
        "supported_seat_ids": {
          "items": {
            "type": "string"
          },
          "title": "Supported Seat Ids",
          "type": "array"
        },
        "unaccepted_mission_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Unaccepted Mission Ids",
          "type": "array"
        }
      },
      "required": [
        "boot_id",
        "state",
        "active_mission_id",
        "supported_seat_ids",
        "can_cancel",
        "execution_profile"
      ],
      "title": "SnapshotPayload",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "ack": "#/$defs/AckEvent",
      "mission.accepted": "#/$defs/AcceptedEvent",
      "mission.phase": "#/$defs/PhaseEvent",
      "mission.rejected": "#/$defs/RejectedEvent",
      "mission.result": "#/$defs/ResultEvent",
      "robot.heartbeat": "#/$defs/HeartbeatEvent",
      "robot.snapshot": "#/$defs/SnapshotEvent"
    },
    "propertyName": "event_type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/SnapshotEvent"
    },
    {
      "$ref": "#/$defs/HeartbeatEvent"
    },
    {
      "$ref": "#/$defs/AcceptedEvent"
    },
    {
      "$ref": "#/$defs/RejectedEvent"
    },
    {
      "$ref": "#/$defs/PhaseEvent"
    },
    {
      "$ref": "#/$defs/ResultEvent"
    },
    {
      "$ref": "#/$defs/AckEvent"
    }
  ]
}
