{
  "$defs": {
    "AcceptedEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "const": "mission.accepted",
          "title": "Event Type",
          "type": "string"
        },
        "mission_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mission Id"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/AcceptedPayload"
        },
        "robot_id": {
          "const": "cleany-01",
          "title": "Robot Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "robot_id",
        "mission_id",
        "sequence",
        "occurred_at",
        "event_type",
        "payload"
      ],
      "title": "AcceptedEvent",
      "type": "object"
    },
    "AcceptedPayload": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "default": "Robot accepted the mission.",
          "title": "Message",
          "type": "string"
        }
      },
      "title": "AcceptedPayload",
      "type": "object"
    },
    "AckEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "const": "ack",
          "title": "Event Type",
          "type": "string"
        },
        "mission_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mission Id"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
