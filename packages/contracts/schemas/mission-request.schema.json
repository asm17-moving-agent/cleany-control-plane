{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cleany.dev/contracts/mission-request.schema.json",
  "title": "MissionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["seat_id", "priority", "requested_by", "idempotency_key"],
  "properties": {
    "seat_id": { "type": "string", "minLength": 1 },
    "priority": { "enum": ["NORMAL", "HIGH"] },
    "requested_by": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 }
  }
}

