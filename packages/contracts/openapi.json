            "type": "string"
          },
          "occupant_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Occupant Name"
          },
          "row": {
            "maximum": 6.0,
            "minimum": 1.0,
            "title": "Row",
            "type": "integer"
          },
          "seat_id": {
            "pattern": "^seat-(?:[0-9]{2}|(?:a[1-4]|m[1-3])-0[1-6])$",
            "title": "Seat Id",
            "type": "string"
          },
          "zone_id": {
            "default": "d-hub",
            "enum": [
              "d-hub",
              "space-a1",
              "space-a2",
              "space-a3",
              "space-a4",
              "space-m1",
              "space-m2",
              "space-m3"
            ],
            "title": "Zone Id",
            "type": "string"
          }
        },
        "required": [
          "seat_id",
          "label",
          "row",
          "grid_column",
          "occupancy",
          "occupant_name"
