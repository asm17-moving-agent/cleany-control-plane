          "received_at": {
            "title": "Received At",
            "type": "string"
          },
          "x": {
            "title": "X",
            "type": "number"
          },
          "y": {
            "title": "Y",
            "type": "number"
          },
          "yaw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "World heading in radians, +X=0, counterclockwise positive; null when unavailable",
            "title": "Yaw"
          }
        },
        "required": [
          "x",
          "y",
          "received_at"
        ],
        "title": "RobotPose",
        "type": "object"
      },
