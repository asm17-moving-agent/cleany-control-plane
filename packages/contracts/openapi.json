      "SeatResponse": {
        "properties": {
          "grid_column": {
            "enum": [
              1,
              2,
              3,
              5,
              6,
              8,
              9,
              10
            ],
            "title": "Grid Column",
            "type": "integer"
          },
          "label": {
            "pattern": "^(?:[0-9]{2}|(?:A[1-4]|M[1-3])-0[1-6])$",
            "title": "Label",
            "type": "string"
          },
          "mission_supported": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mission Supported"
          },
          "occupancy": {
            "enum": [
              "AVAILABLE",
              "OCCUPIED",
              "UNKNOWN"
            ],
